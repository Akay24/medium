{
  "name": "article-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first CLI that turns a topic request into a researched, illustrated, quality-reviewed technical article package for Medium (manual publishing).",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "article-pipeline": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
